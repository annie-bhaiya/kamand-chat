NODE_ENV=development
PORT=4000
HOST=127.0.0.1
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173
# Must also be allowed in hosted Supabase Auth > URL Configuration.
AUTH_EMAIL_REDIRECT_URL=https://kamandchat.highliftpages.com
# Set to 1 only when behind exactly one trusted reverse proxy.
TRUST_PROXY=0
SUPABASE_URL=http://127.0.0.1:54321
# Copy the local publishable/anon key from `npm run db:status`.
SUPABASE_PUBLISHABLE_KEY=
# Only the migration script requires a database connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Required for remote SQL connections. Local loopback connections use no TLS.
DATABASE_SSL_CA=
STORAGE_BUCKET=chat-attachments
MAX_UPLOAD_BYTES=10485760
# Optional: enable the cross-instance Socket.IO Redis adapter.
REDIS_URL=
# Optional, development-project integration tests only (not used by request handlers):
# RUN_LIVE_TESTS=1
# SUPABASE_SECRET_KEY=
# Server-only Gemini credentials. Never use NEXT_PUBLIC_ for this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
