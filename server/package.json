{
  "name": "first-commit-chat-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:integration": "tsx --test test/live.integration.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:push": "supabase db push",
    "db:apply": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/check.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "@supabase/supabase-js": "2.117.3",
    "cors": "2.8.6",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "redis": "6.3.0",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "socket.io-client": "4.8.4",
    "supabase": "2.120.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
