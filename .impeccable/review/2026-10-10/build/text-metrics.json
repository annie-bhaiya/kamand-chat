[{"id":"7:4","text":"01","w":78,"size":26.399999618530273,"style":"Regular"},{"id":"7:5","text":"IIT MANDI · NORTH & SOUTH CAMPUSES","w":1500,"size":33.599998474121094,"style":"Medium"},{"id":"7:6","text":"Kamand Chat","w":1704,"size":144,"style":"Medium"},{"id":"7:7","text":"A shared campus workspace\nbuilt around conversations","w":1392,"size":57.599998474121094,"style":"Regular"},{"id":"7:8","text":"Project presentation · Problem, implementation & impact","w":1620,"size":33.599998474121094,"style":"Regular"},{"id":"7:10","text":"The campus coordination problem","w":1692,"size":76.80000305175781,"style":"Medium"},{"id":"7:11","text":"02","w":78,"size":26.399999618530273,"style":"Regular"},{"id":"7:12","text":"Students need to find\npeople and act on\ncampus information\nin one place.","w":732,"size":74.4000015258789,"style":"Medium"},{"id":"7:14","text":"Finding the right community","w":780,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:15","text":"A peer, club, branch or residence group may require a different search or channel.","w":780,"size":36,"style":"Regular"},{"id":"7:17","text":"Turning messages into action","w":780,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:18","text":"An event plan or maintenance issue needs a record and status beyond a chat thread.","w":780,"size":36,"style":"Regular"},{"id":"7:20","text":"Keeping everyday context visible","w":780,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:21","text":"Menus, venue availability and assigned responsibilities should be easy to retrieve.","w":780,"size":36,"style":"Regular"},{"id":"7:22","text":"Problem framing inferred from the implemented workflows; user research is a next step.","w":1620,"size":26.399999618530273,"style":"Regular"},{"id":"7:24","text":"Who the project serves","w":1692,"size":76.80000305175781,"style":"Medium"},{"id":"7:25","text":"03","w":78,"size":26.399999618530273,"style":"Regular"},{"id":"7:26","text":"Students","w":564,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:27","text":"Find peers, join relevant conversations and check everyday campus information.","w":1032,"size":36,"style":"Regular"},{"id":"7:28","text":"Club organizers","w":564,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:29","text":"Plan events, manage their records and identify venue conflicts.","w":1032,"size":36,"style":"Regular"},{"id":"7:30","text":"Wardens & caretakers","w":564,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:31","text":"Review assigned maintenance reports and record progress toward resolution.","w":1032,"size":36,"style":"Regular"},{"id":"7:32","text":"Mess managers","w":564,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:33","text":"Maintain recurring menus and respond to dining maintenance issues.","w":1032,"size":36,"style":"Regular"},{"id":"7:34","text":"Campus roles control management actions; students remain the primary audience.","w":1644,"size":31.200000762939453,"style":"Regular"},{"id":"7:36","text":"The proposed solution","w":1692,"size":76.80000305175781,"style":"Medium"},{"id":"7:37","text":"04","w":78,"size":26.399999618530273,"style":"Regular"},{"id":"7:40","text":"Start with chat","w":438,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:41","text":"Direct and group conversations are the central workspace.","w":438,"size":36,"style":"Regular"},{"id":"7:43","text":"Add campus context","w":438,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:44","text":"Discover clubs and reach assigned hostel, branch and mess rooms.","w":438,"size":36,"style":"Regular"},{"id":"7:46","text":"Keep actions close","w":438,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:47","text":"Open calendar, tickets or menus from the same interface.","w":438,"size":36,"style":"Regular"},{"id":"7:48","text":"Development fixture · layout demonstration, not live student messages","w":1200,"size":24,"style":"Regular"},{"id":"7:50","text":"Problem-solving approach","w":1692,"size":76.80000305175781,"style":"Medium"},{"id":"7:51","text":"05","w":78,"size":26.399999618530273,"style":"Regular"},{"id":"7:52","text":"01","w":360,"size":81.5999984741211,"style":"Medium"},{"id":"7:54","text":"Model campus context","w":360,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:55","text":"Map users, conversations, membership and assigned campus roles.","w":360,"size":36,"style":"Regular"},{"id":"7:56","text":"02","w":360,"size":81.5999984741211,"style":"Medium"},{"id":"7:58","text":"Persist the workflow","w":360,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:59","text":"Use database functions and access policies for messages and campus records.","w":360,"size":36,"style":"Regular"},{"id":"7:60","text":"03","w":360,"size":81.5999984741211,"style":"Medium"},{"id":"7:62","text":"Sync the interface","w":360,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:63","text":"Deliver change events and refresh records after reconnect or focus.","w":360,"size":36,"style":"Regular"},{"id":"7:64","text":"04","w":360,"size":81.5999984741211,"style":"Medium"},{"id":"7:66","text":"Refine for daily use","w":360,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:67","text":"Test responsive chat, readable states and personal visual preferences.","w":360,"size":36,"style":"Regular"},{"id":"7:68","text":"Keep conversation fast to access.\nMake every campus action explicit.","w":1668,"size":48,"style":"Medium"},{"id":"7:70","text":"Technology stack","w":1692,"size":76.80000305175781,"style":"Medium"},{"id":"7:71","text":"06","w":78,"size":26.399999618530273,"style":"Regular"},{"id":"7:72","text":"Client","w":564,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:73","text":"Next.js 16 · React 19 · TypeScript\nTailwind CSS 4 · Lucide · locally hosted DM Sans","w":1032,"size":36,"style":"Regular"},{"id":"7:74","text":"API & realtime","w":564,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:75","text":"Node.js 22+ · Express 5 · Socket.IO 4\nZod validation · Helmet · rate limiting","w":1032,"size":36,"style":"Regular"},{"id":"7:76","text":"Data & identity","w":564,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:77","text":"Supabase Auth · PostgreSQL with RLS and RPC\nPrivate object storage · PostgreSQL full-text search","w":1032,"size":36,"style":"Regular"},{"id":"7:78","text":"Delivery & verification","w":564,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:79","text":"Docker · Azure Container Apps · Bicep\nVitest / Testing Library · Node tests · Supertest / PGlite","w":1032,"size":36,"style":"Regular"},{"id":"7:81","text":"System architecture","w":1692,"size":76.80000305175781,"style":"Medium"},{"id":"7:82","text":"07","w":78,"size":26.399999618530273,"style":"Regular"},{"id":"7:84","text":"Browser client","w":421.20001220703125,"size":36,"style":"SemiBold"},{"id":"7:85","text":"Next.js + React\nSession & local preferences","w":421.20001220703125,"size":30,"style":"Regular"},{"id":"7:87","text":"Application server","w":421.20001220703125,"size":36,"style":"SemiBold"},{"id":"7:88","text":"Express REST API\nAuthenticated Socket.IO","w":421.20001220703125,"size":30,"style":"Regular"},{"id":"7:90","text":"Supabase Auth","w":325.20001220703125,"size":36,"style":"SemiBold"},{"id":"7:91","text":"Identity & session verification","w":325.20001220703125,"size":30,"style":"Regular"},{"id":"7:93","text":"PostgreSQL","w":325.20001220703125,"size":36,"style":"SemiBold"},{"id":"7:94","text":"RLS · RPC · records · search","w":325.20001220703125,"size":30,"style":"Regular"},{"id":"7:96","text":"Private Storage","w":325.20001220703125,"size":36,"style":"SemiBold"},{"id":"7:97","text":"Files & signed downloads","w":325.20001220703125,"size":30,"style":"Regular"},{"id":"7:104","text":"HTTPS\n→","w":165.60000610351562,"size":26.399999618530273,"style":"Regular"},{"id":"7:105","text":"Writes: browser → API → database\nUpdates: server → Socket.IO → authorized members","w":1092,"size":38.400001525878906,"style":"Regular"},{"id":"7:106","text":"Two app containers on Azure; hosted Supabase supplies identity, data and files.\nBackend deployment currently uses one replica.","w":1164,"size":28.799999237060547,"style":"Regular"},{"id":"7:108","text":"Key implementation challenges","w":1692,"size":76.80000305175781,"style":"Medium"},{"id":"7:109","text":"08","w":78,"size":26.399999618530273,"style":"Regular"},{"id":"7:110","text":"Retries & ordering","w":564,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:111","text":"Stable client message IDs deduplicate retries;\nconversation sequence numbers order messages.","w":1032,"size":36,"style":"Regular"},{"id":"7:112","text":"Access & role boundaries","w":564,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:113","text":"RLS, database functions and server permission checks\nlimit membership and management actions.","w":1032,"size":36,"style":"Regular"},{"id":"7:114","text":"Stale or conflicting records","w":564,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:115","text":"Realtime hints plus reconnect/focus refresh keep panels current;\nvenue booking conflicts are recorded explicitly.","w":1032,"size":36,"style":"Regular"},{"id":"7:116","text":"Mobile density & visual state","w":564,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:117","text":"Responsive navigation and contextual tools preserve space;\nsemantic theme tokens adapt light/dark and accent choices.","w":1032,"size":36,"style":"Regular"},{"id":"7:119","text":"Core messaging features","w":1692,"size":76.80000305175781,"style":"Medium"},{"id":"7:120","text":"09","w":78,"size":26.399999618530273,"style":"Regular"},{"id":"7:122","text":"Direct & group conversations","w":1080,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:123","text":"Student search, group membership and owner controls.","w":1080,"size":36,"style":"Regular"},{"id":"7:125","text":"Live conversation feedback","w":1080,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:126","text":"Message updates, typing indicators, read state and reactions.","w":1080,"size":36,"style":"Regular"},{"id":"7:128","text":"Attachments & message history","w":1080,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:129","text":"Draft previews, private downloads and conversation search.","w":1080,"size":36,"style":"Regular"},{"id":"7:131","text":"Edit, delete & retry","w":1080,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:132","text":"Persisted message changes and stable IDs for retry deduplication.","w":1080,"size":36,"style":"Regular"},{"id":"7:134","text":"Development fixture · mobile layout","w":396,"size":22.799999237060547,"style":"Regular"},{"id":"7:136","text":"Campus tools in the same workspace","w":1692,"size":76.80000305175781,"style":"Medium"},{"id":"7:137","text":"10","w":78,"size":26.399999618530273,"style":"Regular"},{"id":"7:139","text":"Calendar & venue planning","w":714,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:140","text":"Create and manage events; show overlapping reservations as conflicts.","w":714,"size":36,"style":"Regular"},{"id":"7:142","text":"Maintenance accountability","w":714,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:143","text":"Report issues, vote on reports and track permission-based status changes.","w":714,"size":36,"style":"Regular"},{"id":"7:145","text":"Daily dining information","w":714,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:146","text":"Browse weekday menus, serving notes and manager edits.","w":714,"size":36,"style":"Regular"},{"id":"7:148","text":"Development fixture · menu content shown for design review","w":864,"size":25.200000762939453,"style":"Regular"},{"id":"7:149","text":"Rebate drafts remain local.\nOfficial submission is future scope.","w":864,"size":32.400001525878906,"style":"Medium"},{"id":"7:151","text":"What makes the solution distinct","w":1692,"size":76.80000305175781,"style":"Medium"},{"id":"7:152","text":"11","w":78,"size":26.399999618530273,"style":"Regular"},{"id":"7:155","text":"Campus context shapes access","w":1116,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:156","text":"Branch, hostel, block and mess details inform relevant rooms and actions.","w":1116,"size":36,"style":"Regular"},{"id":"7:158","text":"Conversations lead to persistent work","w":1116,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:159","text":"Events and maintenance records keep status outside transient chat threads.","w":1116,"size":36,"style":"Regular"},{"id":"7:161","text":"A calm, personal workspace","w":1116,"size":39.599998474121094,"style":"SemiBold"},{"id":"7:162","text":"Campus Paper, neutral dark mode, accent choices, text sizes and reduced motion.","w":1116,"size":36,"style":"Regular"},{"id":"7:163","text":"Development fixture · campus navigation","w":468,"size":22.799999237060547,"style":"Regular"},{"id":"7:165","text":"Potential impact & future scope","w":1692,"size":76.80000305175781,"style":"Medium"},{"id":"7:166","text":"12","w":78,"size":26.399999618530273,"style":"Regular"},{"id":"7:167","text":"Potential impact","w":720,"size":43.20000076293945,"style":"SemiBold"},{"id":"7:168","text":"Less effort finding relevant peers\nand campus communities.\n\nClearer event and maintenance status.\n\nEveryday information available\nbeside student conversations.","w":720,"size":39.599998474121094,"style":"Regular"},{"id":"7:169","text":"Future scope","w":780,"size":43.20000076293945,"style":"SemiBold"},{"id":"7:170","text":"Validate the workflow with campus users.\n\nConnect approved institutional services\nand official rebate processing.\n\nAdd notifications and strengthen\nmulti-replica realtime operations.","w":780,"size":39.599998474121094,"style":"Regular"},{"id":"7:171","text":"Impact is anticipated. Measure task completion, time to find information and resolution times in a pilot.","w":1644,"size":31.200000762939453,"style":"Regular"}]
