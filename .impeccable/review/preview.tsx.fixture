'use client';
// Temporary browser fixture: never included in the final production build.
import Home from '../page';
import { api } from '@/lib/api';
import { socketManager } from '@/lib/socket';
import { Conversation, Message, Profile } from '@/types/chat';
import { useEffect, useState } from 'react';
const date = new Date().toISOString();
const me: Profile = {id:'me',username:'aarav',display_name:'Aarav Sharma',avatar_key:null,created_at:date};
const peer: Profile = {...me,id:'peer',username:'ananya',display_name:'Ananya Singh'};
const conversations: Conversation[] = [
 {id:'sample-chat',type:'direct',title:null,created_by:'me',last_seq:4,last_message_at:date,last_activity_at:date,created_at:date,conversation_members:[me,peer].map(p=>({conversation_id:'sample-chat',user_id:p.id,role:'member',joined_at:date,left_at:null,last_read_seq:4,profiles:p}))},
 {id:'campus-chat',type:'group',title:'#Kamand Prompt',created_by:'me',last_seq:0,last_message_at:null,last_activity_at:date,created_at:date,conversation_members:[]},
 {id:'course-chat',type:'group',title:'#IC152 - Computing & Data Science',created_by:'me',last_seq:0,last_message_at:null,last_activity_at:date,created_at:date,conversation_members:[]}
];
const messages: Message[] = ['Are you heading to the library after class?', 'Yes! Let’s meet near the entrance at 4.', 'Perfect. I’ll bring the IC152 notes.', 'See you there!'].map((body,i)=>({id:`m${i}`,conversation_id:'sample-chat',seq:i+1,sender_id:i%2?'me':'peer',client_message_id:`retry${i}`,body,kind:'text',created_at:date,edited_at:null,deleted_at:null,attachments:[],message_reactions:[]}));
export default function Preview(){
 const [ready,setReady]=useState(false);
 useEffect(()=>{
  api.getAccessToken=()=> 'fixture-only';
  api.getMe=async()=>({data:{user:{id:'me',email:'sample@example.com'},profile:me}});
  api.getConversations=async()=>({data:conversations});
  api.getMessages=async()=>({data:messages,next_cursor:null});
  api.markRead=async()=>({data:{conversation_id:'sample-chat',user_id:'me',last_read_seq:4}});
  api.getCampusRoomPermissions=async slug=>({data:{roomSlug:slug,isAdmin:false,canBookEvents:false,canResolveTickets:false,canBroadcastMoodle:false,canUpdateMenu:false}});
  api.getMoodleData=async code=>({data:{courseCode:code,moodleHost:'moodle.iitmandi.ac.in',lastSynced:null,assignments:[{id:'assignment',courseCode:code,title:'Assignment 3: Data structures',description:'Practice lists, dictionaries, and algorithmic thinking.',type:'assignment',dueDate:date,moodleUrl:'https://moodle.iitmandi.ac.in',status:'pending',weightage:'10%'}]}});
  socketManager.connect=()=>{}; socketManager.disconnect=()=>{}; socketManager.isConnected=()=>false;
  // eslint-disable-next-line react-hooks/set-state-in-effect
  setReady(true);
 },[]);
 return ready ? <><Home/><div style={{position:'fixed',bottom:4,right:8,fontSize:10,color:'var(--text-muted)',pointerEvents:'none'}}>Sample data · design review</div></>:null;
}
