      "css": ".ds-received {padding:11px 16px;border-radius:12px;border-bottom-left-radius:4px;background:var(--bubble-received);color:var(--text-primary);font-family:var(--font-sans);font-size:1rem;line-height:1.6;word-break:break-word;} .ds-received-meta {display:flex;justify-content:flex-end;margin-top:4px;font-size:.8rem;color:var(--text-muted);opacity:.8;}"
