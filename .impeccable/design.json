      "css": ".ds-sent {padding:11px 16px;border-radius:12px;border-bottom-right-radius:4px;background:var(--accent);color:var(--on-accent);font-family:var(--font-sans);font-size:1rem;line-height:1.6;word-break:break-word;} .ds-meta {display:flex;justify-content:flex-end;gap:4px;margin-top:4px;font-size:.8rem;color:inherit;opacity:.8;}"
    },
