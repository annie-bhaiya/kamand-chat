      "css": ".ds-option {display:flex;align-items:center;justify-content:center;gap:8px;min-height:52px;width:100%;border:1px solid var(--border-medium);border-radius:8px;background:var(--bg-secondary);color:var(--text-secondary);font-family:var(--font-sans);font-size:.867rem;cursor:pointer;transition:background-color var(--transition-fast),border-color var(--transition-fast);} .ds-option:hover {background:var(--bg-glass-hover);} .ds-option[aria-pressed=true] {background:var(--accent-light);border-color:var(--accent);color:var(--accent);} .ds-option:focus-visible {outline:2px solid var(--accent);outline-offset:3px;}"
    }
  ],
  "narrative": {
    "northStar": "Campus Paper",
    "overview": "Campus Paper describes the implemented world: warm paper surfaces, pine ink and a locally bundled humanist sans serif. The palette gives conversations a calm reading ground, with accent colour reserved for sending, selection and focused interaction.\n\nThe same surface and control vocabulary carries through authentication, chat and campus tools. Density and type size are adjustable; light, dark and system appearance share semantic tokens. This record describes the final code, not a pixel specification inferred from the historical mockup.",
    "keyCharacteristics": [
      "Warm paper surfaces and pine ink, with Clay and Lake accent choices.",
      "DM Sans throughout, with moderate headings and generous message leading.",
      "Flat everyday surfaces; lifted dialogs and toasts.",
      "Immediate visual preferences and device-aware reduced motion."
    ],
    "rules": [
      {
        "name": "Semantic Accent",
        "body": "Use accent with on-accent for filled actions; use accent-light with accent for selection.",
        "section": "colors"
      },
      {
        "name": "Reading First",
        "body": "Message text uses the body size with more generous leading; metadata stays smaller.",
        "section": "typography"
      },
      {
        "name": "Quiet Surface",
        "body": "Keep daily conversation surfaces flat; reserve structural shadows for dialogs and toasts.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic CSS variables so dark appearance and accent preferences propagate.",
      "Do keep messages at the reading size and leading, with metadata visibly subordinate.",
      "Do preserve focus, selected state and reduced-motion treatments when extending controls.",
      "Do reuse the shared modal and campus record/form patterns."
    ],
    "donts": [
      "Don't replace semantic accent text with hardcoded white; use on-accent for filled actions and sent messages.",
      "Don't copy an earlier CSS declaration without checking the later cascade overrides.",
      "Don't rely on hover to expose message actions on touch screens.",
      "Don't treat sample campus records as live institutional data."
    ]
  }
}
