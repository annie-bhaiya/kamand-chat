      "css": ".ds-tabs {display:flex;gap:3px;flex-wrap:wrap;} .ds-tab {padding:6px 12px;border:0;border-radius:6px;min-height:34px;font-family:var(--font-sans);font-size:.8rem;font-weight:600;background:transparent;color:var(--text-secondary);cursor:pointer;transition:background-color var(--transition-fast);} .ds-tab[aria-pressed=true] {background:var(--accent-light);color:var(--accent);} .ds-tab:focus-visible {outline:2px solid var(--accent);outline-offset:3px;}"
    },
    {
      "name": "Campus status",
      "kind": "chip",
      "refersTo": "campus-status",
      "description": "Status label on a campus record.",
      "html": "<span class=\"ds-status\">Open</span>",
      "css": ".ds-status {display:inline-block;background:var(--accent-light);color:var(--accent);padding:3px 8px;border-radius:6px;font-family:var(--font-sans);font-size:.8rem;}"
    },
    {
      "name": "Campus form container",
      "kind": "card",
      "refersTo": "campus-form",
      "description": "Soft surface for campus forms.",
      "html": "<section class=\"ds-campus-form\"><h4>Report an issue</h4><label>Title<input class=\"ds-campus-input\" placeholder=\"What happened?\" /></label></section>",
      "css": ".ds-campus-form {display:flex;flex-direction:column;gap:16px;padding:20px;background:var(--bg-tertiary);border-radius:12px;font-family:var(--font-sans);color:var(--text-primary);} .ds-campus-form h4 {margin:0;font-size:1.067rem;font-weight:600;line-height:1.4;letter-spacing:-.02em;} .ds-campus-form label {display:flex;flex-direction:column;gap:8px;font-size:.867rem;color:var(--text-secondary);} .ds-campus-input {padding:11px 14px;border:1px solid var(--border-subtle);border-radius:8px;background:var(--bg-secondary);color:var(--text-primary);font-family:var(--font-sans);font-size:1rem;} .ds-campus-input:hover {border-color:var(--border-medium);} .ds-campus-input:focus {outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-light);}"
    },
    {
      "name": "Sent message",
      "kind": "custom",
      "refersTo": "message-sent",
      "description": "Outgoing reading surface and subordinate timestamp.",
